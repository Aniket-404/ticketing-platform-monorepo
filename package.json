{
  "name": "ticketing-platform-monorepo",
  "description": "Dynamic event ticketing platform with intelligent pricing - Assignment starter",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Minsky Digital Labs",
    "email": "reneeth@minsky.in",
    "url": "https://minsky.in"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/ticketing-platform-monorepo"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:clean": "pnpm kill:ports && pnpm dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "kill:4000": "powershell -File kill-port-4000.ps1",
    "kill:ports": "kill-port 4000 3000"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
