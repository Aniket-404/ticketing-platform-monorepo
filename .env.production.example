# Production Environment Variables for Render Deployment

# Database Configuration (Auto-generated by Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database

# Application Configuration
NODE_ENV=production
PORT=4000

# Pricing Algorithm Weights (0-1 range)
PRICING_WEIGHT_DEMAND=0.3
PRICING_WEIGHT_TIME=0.2
PRICING_WEIGHT_INVENTORY=0.5

# Frontend API URL (Update with your actual Render API URL)
NEXT_PUBLIC_API_URL=https://your-api-name.onrender.com
